float Clamp(float value, float minimum, float maximum)
{
    if (value < minimum)
        return minimum;
    if (value > maximum)
        return maximum;
    return value;
}

float Distance2D(
    float firstX,
    float firstZ,
    float secondX,
    float secondZ)
{
    const float dx = firstX - secondX;
    const float dz = firstZ - secondZ;
    return sqrt(dx * dx + dz * dz);
}

float WrapAngle(float value)
{
    while (value > 3.141592654f)
        value -= 6.283185307f;
    while (value < -3.141592654f)
        value += 6.283185307f;
    return value;
}

