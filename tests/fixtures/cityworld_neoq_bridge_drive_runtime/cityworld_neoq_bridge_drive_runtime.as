{
    gStation.resize(81);
    gStation[0] = 0.0f;
    gStation[1] = 10.0f;
    for (uint index = 2; index <= 72; index++)
        gStation[index] = 50.0f + 40.0f * float(index - 2);
    gStation[73] = 2886.132100441f;
    gStation[74] = 2890.0f;
    gStation[75] = 2930.0f;
    gStation[76] = 2970.0f;
    gStation[77] = 3010.0f;
    gStation[78] = 3046.132100441f;
    gStation[79] = 3050.0f;
    gStation[80] = DESTINATION_SEAM_STATION;
}

bool ValidateRouteContract()
{
    if (gPath.length() != 81 || gStation.length() != gPath.length())
        return false;
    for (uint index = 0; index + 1 < gStation.length(); index++)
    {
        if (gStation[index + 1] <= gStation[index])
            return false;
    }
    if (
        Distance2D(gPath[0].x, gPath[0].z, 3780.970703f, 3993.104004f)
            > 0.01f ||
        Distance2D(gPath[1].x, gPath[1].z, 3790.970703f, 3993.104004f)
            > 0.01f ||
        Distance2D(gPath[80].x, gPath[80].z, 6867.0f, 4018.0f)
            > 0.01f)
    {
        return false;
    }
    return (
        abs(gStation[1] - SOURCE_SEAM_STATION) <= 0.01f &&
        abs(gStation[80] - DESTINATION_SEAM_STATION) <= 0.01f &&
        abs(gStation[80] - ROUTE_LENGTH_M) <= 0.01f);
}

void FindClosestPath(const vector3 &in position)
{
    float bestSquared = 1000000000.0f;
    for (uint index = 0; index + 1 < gPath.length(); index++)
    {
        const float dx = gPath[index + 1].x - gPath[index].x;
        const float dz = gPath[index + 1].z - gPath[index].z;
        const float lengthSquared = dx * dx + dz * dz;
        if (lengthSquared <= 0.000001f)
            continue;
        const float fraction = Clamp(
            (
                (position.x - gPath[index].x) * dx +
                (position.z - gPath[index].z) * dz
            ) / lengthSquared,
            0.0f,
            1.0f);
        const float projectedX = gPath[index].x + fraction * dx;
        const float projectedZ = gPath[index].z + fraction * dz;
        const float offsetX = position.x - projectedX;
        const float offsetZ = position.z - projectedZ;
        const float squared = offsetX * offsetX + offsetZ * offsetZ;
        if (squared >= bestSquared)
            continue;
        bestSquared = squared;
        const float length = sqrt(lengthSquared);
        gClosestStation =
            gStation[index] +
            fraction * (gStation[index + 1] - gStation[index]);
        gClosestCrossTrack = (dx * offsetZ - dz * offsetX) / length;
        gClosestSurfaceY =
            gPath[index].y +
            fraction * (gPath[index + 1].y - gPath[index].y);
    }
}

vector3 SamplePath(float station)
{
    if (station <= gStation[0])
        return gPath[0];
    const uint last = gStation.length() - 1;
    if (station >= gStation[last])
    {
        const vector3 delta = gPath[last] - gPath[last - 1];
        const float segmentLength =
            gStation[last] - gStation[last - 1];
        return (
            gPath[last] +
            delta * ((station - gStation[last]) / segmentLength)
        );
    }
    for (uint index = 0; index < last; index++)
    {
        if (station > gStation[index + 1])
            continue;
        const float fraction =
            (station - gStation[index]) /
            (gStation[index + 1] - gStation[index]);
        return gPath[index] + (gPath[index + 1] - gPath[index]) * fraction;
    }
    return gPath[last];
}

vector3 PathTangent(float station)
{
    const vector3 before = SamplePath(station - 1.0f);
    const vector3 after = SamplePath(station + 1.0f);
    vector3 tangent(after.x - before.x, 0.0f, after.z - before.z);
    const float length = sqrt(tangent.x * tangent.x + tangent.z * tangent.z);
    if (length > 0.000001f)
    {
        tangent.x /= length;
        tangent.z /= length;
    }
    return tangent;
}

float TargetCrossTrack(float station)
{
    const float linear = Clamp(
        (
            station - DESTINATION_LANE_SHIFT_START_M
        ) / (
            DESTINATION_LANE_SHIFT_END_M -
            DESTINATION_LANE_SHIFT_START_M
        ),
        0.0f,
        1.0f);
    const float eased = linear * linear * (3.0f - 2.0f * linear);
    return (
        gReferenceCrossTrack +
        eased * (
            DESTINATION_LANE_CROSS_TRACK_M -
            gReferenceCrossTrack
        ));
}

void ApplySteer(float steer)
{
    if (steer >= 0.0f)
    {
        gActor.setEventSimulatedValue(EV_TRUCK_STEER_LEFT, steer);
        gActor.setEventSimulatedValue(EV_TRUCK_STEER_RIGHT, 0.0f);
    }
    else
    {
        gActor.setEventSimulatedValue(EV_TRUCK_STEER_LEFT, 0.0f);
        gActor.setEventSimulatedValue(EV_TRUCK_STEER_RIGHT, -steer);
    }
}

void ClearControls()
{
    if (@gActor != null)
        gActor.clearEventSimulatedValues();
}

void Finish()
{
    ClearControls();
    console.cVarSet("sim_deterministic_fixed_steps_per_frame", "0");
    console.cVarSet("ui_hide_gui", "false");
    gState = FINISHED;
}

void Fail(const string &in reason)
{
    if (gState == FINISHED)
        return;
    Finish();
    game.log("[RoR|CW2|NeoBridgeDrive] FAIL reason=" + reason);
    game.quitGame();
}

void main()
{
    InitializeStations();
    if (!ValidateRouteContract())
    {
        Fail("route-contract-invalid");
        return;
    }
    @gAppState = console.cVarFind("app_state");
    @gSimState = console.cVarFind("sim_state");
    if (@gAppState == null || @gSimState == null)
    {
        Fail("required-cvar-missing");
        return;
    }
    console.cVarSet("sim_deterministic_fixed_steps_per_frame", "40");
    console.cVarSet("sim_deterministic_sleeping_engine", "true");
    console.cVarSet("sim_no_collisions", "false");
    console.cVarSet("sim_no_self_collisions", "false");
    console.cVarSet("ui_hide_gui", "true");
    game.registerForEvent(SE_GENERIC_NEW_TRUCK);
    game.log(
        "[RoR|CW2|NeoBridgeDrive] START route_m=3086.132100441 "
        "waypoints=81 vehicle=b6b0UID-semi.truck batch=40 "
        "destination_overlap_m=0");
}

void eventCallbackEx(
    scriptEvents event,
    int arg1,
    int arg2,
    int arg3,
    int arg4,
    string arg5,
    string arg6,
    string arg7,
    string arg8)
{
    if (event != SE_GENERIC_NEW_TRUCK)
        return;
    if (arg1 != ACTOR_ID)
    {
        Fail("unexpected-actor-id-" + arg1);
        return;
    }
    gActorSpawned = true;
}

bool SpawnActor()
{
    return game.pushMessage(
        MSG_SIM_SPAWN_ACTOR_REQUESTED,
        {
            {"filename", VEHICLE},
            {"instance_id", ACTOR_ID},
            {"free_position", true},
            {"enter", false},
            {"position", vector3(3780.970703f, 2.1f, 3993.104004f)},
            // The DAF's physical forward axis is -X. A 180 degree Y rotation
            // aligns it with the bridge's eastbound source tangent.
            {"rotation", quaternion(
                radian(3.141592654f),
                vector3(0.0f, 1.0f, 0.0f))}
        });
}

void HoldCamera(const vector3 &in position)
{
    const vector3 target = SamplePath(gClosestStation + 26.0f);
    game.setCameraPosition(position + vector3(-30.0f, 15.0f, -24.0f));
    game.cameraLookAt(target + vector3(0.0f, 1.6f, 0.0f));
}

void UpdateControls(const vector3 &in position)
{
    const float targetStation = gClosestStation + LOOKAHEAD_M;
    vector3 target = SamplePath(targetStation);
    const vector3 tangent = PathTangent(targetStation);
    const float targetCrossTrack = TargetCrossTrack(targetStation);
    target.x += -tangent.z * targetCrossTrack;
    target.z += tangent.x * targetCrossTrack;
    const float desiredHeading = atan2(
        target.x - position.x,
        -(target.z - position.z));
    const float headingError = WrapAngle(
        gActor.getHeadingDirectionAngle() - desiredHeading);
    ApplySteer(Clamp(headingError * 0.88f, -0.28f, 0.28f));

    const float speed = gActor.getSpeed();
    float throttle = 0.20f;
    if (speed < 5.0f)
        throttle = 0.82f;
    else if (speed < 12.0f)
        throttle = 0.60f;
    else if (speed < 19.0f)
        throttle = 0.42f;
    else if (speed < 23.0f)
        throttle = 0.25f;
    else
        throttle = 0.06f;
    // Arrive at the independently authored destination mesh gently. This
    // avoids treating a high-speed collision impulse at its seam as evidence
    // about the generated bridge's alignment or collision continuity.
    if (gClosestStation > 2920.0f)
    {
        if (speed > 12.0f)
            throttle = 0.0f;
        else if (speed > 9.0f)
            throttle = 0.16f;
        else
            throttle = 0.45f;
    }
    gActor.setEventSimulatedValue(EV_TRUCK_ACCELERATE, throttle);
    gActor.setEventSimulatedValue(
        EV_TRUCK_BRAKE,
        (
            gClosestStation > 2920.0f && speed > 13.0f
            ? 0.28f
            : (speed > 25.0f ? 0.24f : 0.0f)
        ));
}

void UpdateTraversal()
{
    const vector3 position = gActor.getPosition();
    FindClosestPath(position);
    HoldCamera(position);
    UpdateControls(position);

    if (gHasLastPosition)
    {
        gDistance += Distance2D(
            position.x,
            position.z,
            gLastPosition.x,
            gLastPosition.z);
    }
    gLastPosition = position;
    gHasLastPosition = true;

    const float pathError = abs(
        gClosestCrossTrack - TargetCrossTrack(gClosestStation));
    const float verticalError = abs(
        (position.y - gClosestSurfaceY) - gReferenceHeight);
    if (
        gClosestStation < DESTINATION_LANE_SHIFT_START_M &&
        pathError > gMaximumPathError)
        gMaximumPathError = pathError;
    if (verticalError > gMaximumVerticalError)
        gMaximumVerticalError = verticalError;
    const float regression = gPreviousProgress - gClosestStation;
    if (regression > gMaximumRegression)
        gMaximumRegression = regression;
    if (gClosestStation > gPreviousProgress)
        gPreviousProgress = gClosestStation;

    const uint64 physicsSteps = game.getCompletedPhysicsSteps();
    if (
        gClosestStation >=
            gProgressCheckpointStation + PROGRESS_WINDOW_M)
    {
        gProgressCheckpointStation = gClosestStation;
        gProgressCheckpointStep = physicsSteps;
    }
    else if (
        gDrivingFrames > 300 &&
        physicsSteps > gProgressCheckpointStep + MAX_NO_PROGRESS_STEPS)
    {
        Fail("forward-progress-timeout-" + gClosestStation);
        return;
    }

    if (!gSourceSeam && gClosestStation >= SOURCE_SEAM_STATION)
    {
        gSourceSeam = true;
        game.log(
            "[RoR|CW2|NeoBridgeDrive] SEAM name=source station=" +
            gClosestStation + " x=" + position.x + " z=" + position.z);
    }
    if (!gMidpoint && gClosestStation >= MIDPOINT_STATION)
    {
        gMidpoint = true;
        game.log(
            "[RoR|CW2|NeoBridgeDrive] MIDPOINT station=" +
            gClosestStation + " x=" + position.x + " z=" + position.z);
    }
    if (
        !gDestinationSeam &&
        gClosestStation >= DESTINATION_SEAM_STATION)
    {
        gDestinationSeam = true;
        game.log(
            "[RoR|CW2|NeoBridgeDrive] SEAM name=destination station=" +
            gClosestStation + " x=" + position.x + " z=" + position.z);
    }

    if (
        gDrivingFrames > 300 &&
        gClosestStation < DESTINATION_LANE_SHIFT_START_M &&
        pathError > MAX_PATH_ERROR_M)
    {
        Fail("path-error-" + pathError);
        return;
    }
    if (gDrivingFrames > 300 && verticalError > MAX_VERTICAL_ERROR_M)
    {
        Fail("vertical-error-" + verticalError);
        return;
    }
    if (gMaximumRegression > MAX_REGRESSION_M)
    {
        Fail("route-regression-" + gMaximumRegression);
        return;
    }

    if (
        gDestinationSeam &&
        position.x >= PASS_DESTINATION_X_M)
    {
        if (!gSourceSeam || !gMidpoint || !gDestinationSeam)
        {
            Fail("route-marker-missing");
            return;
        }
        if (gMaximumPathError > MAX_PATH_ERROR_M)
        {
            Fail("maximum-path-error-" + gMaximumPathError);
            return;
        }
        if (gMaximumVerticalError > MAX_VERTICAL_ERROR_M)
        {
            Fail("maximum-vertical-error-" + gMaximumVerticalError);
            return;
        }
        if (gDistance < 3050.0f || gDistance > 3400.0f)
        {
            Fail("distance-" + gDistance);
            return;
        }
        const float destinationLocalZ = position.z - 4018.0f;
        if (
            destinationLocalZ < DESTINATION_LANE_SAFE_MIN_LOCAL_Z_M ||
            destinationLocalZ > DESTINATION_LANE_SAFE_MAX_LOCAL_Z_M)
        {
            Fail("destination-lane-footprint-" + destinationLocalZ);
            return;
        }
        const float finalSpeed = gActor.getSpeed();
        const uint64 finalSteps = game.getCompletedPhysicsSteps();
        Finish();
        game.log(
            "[RoR|CW2|NeoBridgeDrive] PASS seams=2 "
            "route_m=3086.132100441 station_m=" + gClosestStation +
            " destination_x_m=" + position.x +
            " destination_local_z_m=" + destinationLocalZ +
            " distance_m=" + gDistance +
            " path_error_m=" + gMaximumPathError +
            " vertical_error_m=" + gMaximumVerticalError +
            " regression_m=" + gMaximumRegression +
            " speed_mps=" + finalSpeed +
            " physics_steps=" + finalSteps);
        game.quitGame();
    }
}

void frameStep(float dt)
{
    if (gState == FINISHED)
        return;

    if (gState == WAITING_FOR_TERRAIN)
    {
        if (gAppState.getInt() == APP_STATE_SIMULATION)
        {
            console.cVarSet("sim_state", "" + SIM_STATE_PAUSED);
            gState = WAITING_FOR_PAUSE;
        }
        return;
    }
    if (gState == WAITING_FOR_PAUSE)
    {
        if (gSimState.getInt() != SIM_STATE_PAUSED)
            return;
        if (!SpawnActor())
        {
            Fail("spawn-request-rejected");
            return;
        }
        gState = WAITING_FOR_ACTOR;
        return;
    }
    if (gState == WAITING_FOR_ACTOR)
    {
        if (!gActorSpawned)
            return;
        @gActor = game.getTruckByNum(ACTOR_ID);
        if (@gActor == null)
        {
            Fail("actor-not-addressable");
            return;
        }
        EngineClass@ engine = gActor.getEngine();
        if (@engine == null)
        {
            Fail("engine-missing");
            return;
        }
        engine.setAutoMode(SimGearboxMode::AUTO);
        engine.startEngine();
        if (gActor.getParkingBrake())
            gActor.parkingbrakeToggle();
        const vector3 position = gActor.getPosition();
        FindClosestPath(position);
        if (gClosestStation < 0.0f || gClosestStation > 4.0f)
        {
            Fail("spawn-not-inside-neoq-road-" + gClosestStation);
            return;
        }
        gReferenceCrossTrack = gClosestCrossTrack;
        gReferenceHeight = position.y - gClosestSurfaceY;
        gPreviousProgress = gClosestStation;
        gProgressCheckpointStation = gClosestStation;
        gProgressCheckpointStep = game.getCompletedPhysicsSteps();
        game.pushMessage(MSG_SIM_UNPAUSE_REQUESTED, {});
        gState = DRIVING;
        game.log(
            "[RoR|CW2|NeoBridgeDrive] ARMED actor=2026072902 "
            "heading=" + gActor.getHeadingDirectionAngle() +
            " station=" + gClosestStation +
            " cross_track=" + gReferenceCrossTrack +
            " height=" + gReferenceHeight);
        return;
    }
    if (gState == DRIVING)
    {
        gDrivingFrames++;
        if (game.getCompletedPhysicsSteps() > MAX_PHYSICS_STEPS)
        {
            Fail("physics-step-timeout");
            return;
        }
        if (gDrivingFrames % 250 == 0)
        {
            const vector3 position = gActor.getPosition();
            game.log(
                "[RoR|CW2|NeoBridgeDrive] SAMPLE frame=" +
                gDrivingFrames +
                " station=" + gClosestStation +
                " x=" + position.x +
                " y=" + position.y +
                " z=" + position.z +
                " speed=" + gActor.getSpeed());
        }
        UpdateTraversal();
    }
}
