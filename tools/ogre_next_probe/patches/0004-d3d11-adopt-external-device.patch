+    //---------------------------------------------------------------------
+    D3D11Driver *D3D11RenderSystem::findExternalDeviceDriver( bool refreshList )
+    {
+        ComPtr<IDXGIDevice> dxgiDevice;
+        ComPtr<IDXGIAdapter> dxgiAdapter;
+        DXGI_ADAPTER_DESC externalDesc;
+        ZeroMemory( &externalDesc, sizeof( externalDesc ) );
+        HRESULT hr = mExternalDevice.As( &dxgiDevice );
+        if( SUCCEEDED( hr ) )
+            hr = dxgiDevice->GetAdapter( dxgiAdapter.GetAddressOf() );
+        if( SUCCEEDED( hr ) )
+            hr = dxgiAdapter->GetDesc( &externalDesc );
+        if( FAILED( hr ) )
+        {
+            OGRE_EXCEPT_EX( Exception::ERR_RENDERINGAPI_ERROR, hr,
+                            "External D3D11 device has no queryable DXGI adapter",
+                            "D3D11RenderSystem::findExternalDeviceDriver" );
+        }
+
+        D3D11DriverList *drivers = getDirect3DDrivers( refreshList );
+        for( size_t i = 0u; i < drivers->count(); ++i )
+        {
+            D3D11Driver *driver = drivers->item( i );
+            const LUID &candidateLuid = driver->getAdapterIdentifier().AdapterLuid;
+            if( candidateLuid.HighPart == externalDesc.AdapterLuid.HighPart &&
+                candidateLuid.LowPart == externalDesc.AdapterLuid.LowPart )
+            {
+                return driver;
+            }
+        }
+        OGRE_EXCEPT( Exception::ERR_RENDERINGAPI_ERROR,
+                     "External D3D11 device adapter is absent from the exact DXGI driver list",
+                     "D3D11RenderSystem::findExternalDeviceDriver" );
+    }
+    //---------------------------------------------------------------------
+    void D3D11RenderSystem::adoptExternalDevice( bool refreshList )
+    {
+        if( !mExternalDevice )
+        {
+            OGRE_EXCEPT( Exception::ERR_INVALIDPARAMS, "External D3D11 device is null",
+                         "D3D11RenderSystem::adoptExternalDevice" );
+        }
+        const HRESULT removedReason = mExternalDevice->GetDeviceRemovedReason();
+        if( FAILED( removedReason ) )
+        {
+            OGRE_EXCEPT_EX( Exception::ERR_RENDERINGAPI_ERROR, removedReason,
+                            "External D3D11 device was removed; owner recreation is required",
+                            "D3D11RenderSystem::adoptExternalDevice" );
+        }
+        D3D11Driver *driver = findExternalDeviceDriver( refreshList );
+        mActiveD3DDriver = *driver;
+        mDriverName = driver->DriverDescription();
+        mFeatureLevel = mExternalDevice->GetFeatureLevel();
+        ComPtr<ID3D11Device> device = mExternalDevice;
+        mDevice.TransferOwnership( device );
+        mExternalDeviceActive = mDevice.get() == mExternalDevice.Get();
+        if( !mExternalDeviceActive )
+        {
+            OGRE_EXCEPT( Exception::ERR_RENDERINGAPI_ERROR,
+                         "External D3D11 device identity changed during adoption",
+                         "D3D11RenderSystem::adoptExternalDevice" );
         }
     }
