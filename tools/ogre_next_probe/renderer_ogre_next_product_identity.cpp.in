#elif defined(__GNUC__) || defined(__clang__)
#define ROR_OGRE_NEXT_PRODUCT_RETAIN __attribute__((used, visibility("default")))
#else
#define ROR_OGRE_NEXT_PRODUCT_RETAIN
#endif

