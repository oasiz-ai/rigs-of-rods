    {
      "id": "ambient_occlusion",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry"],
      "minimum_completed_frames": 600,
      "witness_metric": "occlusion_changed_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "water_reflection_refraction",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
