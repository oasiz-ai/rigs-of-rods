      "minimum_witness_value": 128
    },
    {
      "id": "transparent_particles",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["volumetric_fog_light_shafts"],
      "minimum_completed_frames": 600,
      "witness_metric": "particle_covered_pixels",
      "minimum_witness_value": 64
    },
    {
      "id": "motion_vectors",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry"],
      "minimum_completed_frames": 600,
      "witness_metric": "nonzero_motion_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "temporal_aa",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["motion_vectors", "transparent_particles"],
      "minimum_completed_frames": 600,
      "witness_metric": "stabilized_edge_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "bloom",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["emissive_materials"],
      "minimum_completed_frames": 600,
      "witness_metric": "bloom_changed_pixels",
      "minimum_witness_value": 64
    },
    {
      "id": "auto_exposure",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["base_hdr"],
      "minimum_completed_frames": 600,
      "witness_metric": "adapted_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "filmic_tone_mapping",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["bloom", "auto_exposure", "temporal_aa"],
      "minimum_completed_frames": 600,
      "witness_metric": "tone_mapped_pixels",
      "minimum_witness_value": 2073600
    },
    {
      "id": "srgb_output_transfer",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["filmic_tone_mapping"],
      "minimum_completed_frames": 600,
      "witness_metric": "output_pixels",
      "minimum_witness_value": 2073600
    },
    {
      "id": "ui_composite",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["srgb_output_transfer"],
      "minimum_completed_frames": 600,
      "witness_metric": "ui_covered_pixels",
      "minimum_witness_value": 64
    }
  ]
}
