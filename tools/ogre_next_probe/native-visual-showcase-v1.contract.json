{
  "schema": "ror.native_visual_showcase_contract.v1",
  "version": 1,
  "product_path": "forward-native",
  "minimum_width": 1920,
  "minimum_height": 1080,
  "minimum_main_sequence_frames": 600,
  "required_modes": [
    "raster_high",
    "native_rt_ultra"
  ],
  "required_artifacts": [
    "raster_all_on",
    "native_rt_all_on",
    "native_rt_moved_caster",
    "water_weather_motion",
    "particles_motion",
    "ui_gameplay"
  ],
  "required_passes": [
    {
      "id": "pbr_geometry",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": [],
      "minimum_completed_frames": 600,
      "witness_metric": "distinct_material_response_regions",
      "minimum_witness_value": 6
    },
    {
      "id": "alpha_mask_and_blend",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry"],
      "minimum_completed_frames": 600,
      "witness_metric": "accepted_alpha_edge_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "emissive_materials",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry"],
      "minimum_completed_frames": 600,
      "witness_metric": "emissive_pixels",
      "minimum_witness_value": 64
    },
    {
      "id": "base_hdr",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry", "emissive_materials"],
      "minimum_completed_frames": 600,
      "witness_metric": "finite_hdr_pixels",
      "minimum_witness_value": 2073600
    },
    {
      "id": "sun_direct_hdr",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry"],
      "minimum_completed_frames": 600,
      "witness_metric": "positive_direct_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "pssm_directional_shadow",
      "version": 1,
      "modes": ["raster_high"],
      "depends_on": ["sun_direct_hdr"],
      "minimum_completed_frames": 600,
      "witness_metric": "shadow_changed_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "native_rt_sun_visibility",
      "version": 2,
      "modes": ["native_rt_ultra"],
      "depends_on": ["sun_direct_hdr"],
      "minimum_completed_frames": 600,
      "witness_metric": "ray_traced_shadow_changed_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "analytic_atmosphere",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["base_hdr", "sun_direct_hdr"],
      "minimum_completed_frames": 600,
      "witness_metric": "sky_gradient_rows",
      "minimum_witness_value": 128
    },
    {
      "id": "reflection_probe_ibl",
      "version": 1,
      "modes": ["raster_high", "native_rt_ultra"],
      "depends_on": ["pbr_geometry"],
      "minimum_completed_frames": 600,
      "witness_metric": "probe_affected_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "screen_space_reflections",
      "version": 1,
      "modes": ["raster_high"],
      "depends_on": ["base_hdr", "reflection_probe_ibl"],
      "minimum_completed_frames": 600,
      "witness_metric": "screen_space_reflection_changed_pixels",
      "minimum_witness_value": 128
    },
    {
      "id": "native_rt_reflections",
      "version": 1,
      "modes": ["native_rt_ultra"],
      "depends_on": ["base_hdr", "reflection_probe_ibl"],
