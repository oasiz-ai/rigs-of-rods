{
  "schema_version": 1,
  "provenance": {
    "repository": "@ROR_OGRE_NEXT_REPOSITORY@",
    "branch": "@ROR_OGRE_NEXT_BRANCH@",
    "commit": "@ROR_OGRE_NEXT_COMMIT@",
    "archive_sha256": "@ROR_OGRE_NEXT_ARCHIVE_SHA256@",
    "license_spdx": "@ROR_OGRE_NEXT_LICENSE_SPDX@",
    "license_sha256": "@ROR_OGRE_NEXT_LICENSE_SHA256@"
  },
  "dependencies": {
    "rapidjson": {
      "tag": "@ROR_RAPIDJSON_TAG@",
      "archive_sha256": "@ROR_RAPIDJSON_ARCHIVE_SHA256@",
      "source_archive_license_spdx": "@ROR_RAPIDJSON_LICENSE_SPDX@",
      "compiled_headers_license_spdx": "@ROR_RAPIDJSON_COMPILED_HEADERS_SPDX@",
      "license_sha256": "@ROR_RAPIDJSON_LICENSE_SHA256@"
    }
  },
  "platform": {
    "policy": "@ROR_OGRE_NEXT_PLATFORM_POLICY@",
    "system": "@CMAKE_SYSTEM_NAME@",
    "processor": "@CMAKE_SYSTEM_PROCESSOR@",
    "renderer_target": "@ROR_OGRE_NEXT_RENDERER_TARGET@",
    "device_option_name": "@ROR_OGRE_NEXT_DEVICE_OPTION_NAME@"
  },
  "abi": {
    "cxx_standard": 17,
    "static_link": true,
    "new_project_name": true,
    "debug_level_debug": 3,
    "debug_level_release": 0,
    "embed_debug_mode": "auto",
    "assert_mode": 0,
    "double_precision": false,
    "allocator": 0,
    "container_custom_allocator": false,
    "string_custom_allocator": false,
    "memory_tracker_debug": false,
    "memory_tracker_release": false,
    "thread_support": 0,
    "thread_provider": "none",
    "id_string_128": false,
    "id_string_always_readable": false,
    "node_inherit_transform": false,
    "restrict_aliasing": true,
    "flexibility_level": 0,
    "planar_reflections": false,
    "simd_enabled": true,
    "simd_alignment": 16,
    "simd_family": "@ROR_OGRE_NEXT_SIMD_FAMILY@",
    "simd_neon": @ROR_OGRE_NEXT_SIMD_NEON_JSON@,
    "simd_sse2": @ROR_OGRE_NEXT_SIMD_SSE2_JSON@
  },
  "components": {
    "hlms_pbs": true,
    "compositor2_core": true,
    "json_materials": true,
    "mesh_lod": true,
    "dds_codec": true,
    "native_ray_tracing": "not_evaluated"
  },
  "compiler": {
    "id": "@CMAKE_CXX_COMPILER_ID@",
    "version": "@CMAKE_CXX_COMPILER_VERSION@",
    "build_type": "@CMAKE_BUILD_TYPE@"
  }
}
