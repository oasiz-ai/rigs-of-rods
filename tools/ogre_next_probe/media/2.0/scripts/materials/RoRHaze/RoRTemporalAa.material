// RoR temporal anti-aliasing (Stage 5 temporal foundation).
//
// Three full-screen quads inside RoRTemporalAaNodeV1, between the aerial
// haze pass and the stock HDR post node, all on linear pre-tonemap HDR:
//
//  1. RoR/HDR/TaaMotionVectors - camera-reprojection motion vectors from
//     the scene's exported D32 opaque depth (RG16F, previous pixel minus
//     current pixel, jitter removed).
//  2. RoR/HDR/TaaResolve - the temporal resolve: YCoCg variance
//     neighbourhood clipping, previous-depth disocclusion, motion and
//     reactive rejection, exposure-ratio rescale. The GPU sibling of the
//     CPU oracle EvaluateOgreNextTaaPixel in OgreNextTaaContract.cpp.
//  3. RoR/HDR/TaaDepthStore - copies this frame's depth into the
//     persistent R32 history so the next frame can run its disocclusion
//     test.
//
// The vertex program is the stock Ogre/Compositor/Quad_vs already carried
// by the pinned Common media closure; only the fragment programs are
// RoR-owned. Every named constant is bound per frame by the presenter with
// a _readRawConstants readback, so a silent binding drift fails closed
// there. The history texture unit is the only bilinear unit: history is
// sampled at a reprojected, non-texel-aligned position. Every other unit
// stays point-sampled so rejection tests compare exact stored texels.

//------------------------
// Motion vectors
//------------------------
fragment_program RoR/HDR/TaaMotionVectors_ps_GLSL glsl
{
	source RoRTaaMotionVectors_ps.glsl
	default_params
	{
		param_named depthTexture	int 0
	}
}

fragment_program RoR/HDR/TaaMotionVectors_ps_VK glslvk
{
	source RoRTaaMotionVectors_ps.glsl
}

fragment_program RoR/HDR/TaaMotionVectors_ps_HLSL hlsl
{
	source RoRTaaMotionVectors_ps.hlsl
	entry_point main
	target ps_5_0 ps_4_0
}

fragment_program RoR/HDR/TaaMotionVectors_ps_Metal metal
{
	source RoRTaaMotionVectors_ps.metal
	shader_reflection_pair_hint Ogre/Compositor/Quad_vs
}

fragment_program RoR/HDR/TaaMotionVectors_ps unified
{
	delegate RoR/HDR/TaaMotionVectors_ps_GLSL
	delegate RoR/HDR/TaaMotionVectors_ps_VK
	delegate RoR/HDR/TaaMotionVectors_ps_HLSL
	delegate RoR/HDR/TaaMotionVectors_ps_Metal
}

material RoR/HDR/TaaMotionVectors
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref RoR/HDR/TaaMotionVectors_ps
			{
			}

			texture_unit depthTexture
			{
				tex_address_mode	clamp
				filtering			none
			}
		}
	}
}

//------------------------
// Temporal resolve
//------------------------
fragment_program RoR/HDR/TaaResolve_ps_GLSL glsl
{
	source RoRTaaResolve_ps.glsl
	default_params
	{
		param_named rt0					int 0
		param_named depthTexture		int 1
		param_named motionTexture		int 2
		param_named prevDepthTexture	int 3
		param_named historyTexture		int 4
		param_named reactiveTexture		int 5
	}
}

fragment_program RoR/HDR/TaaResolve_ps_VK glslvk
{
	source RoRTaaResolve_ps.glsl
	// The resolve consumes six independent texture/sampler pairs. Ogre-Next's
	// low-level "standard" Vulkan layout exposes four; "high" exposes eight.
	// Declare that shader resource requirement here so Vulkan derives the same
	// binding interface already expressed by GLSL, HLSL, Metal, and the material.
	root_layout high
}

fragment_program RoR/HDR/TaaResolve_ps_HLSL hlsl
{
	source RoRTaaResolve_ps.hlsl
	entry_point main
	target ps_5_0 ps_4_0
}

fragment_program RoR/HDR/TaaResolve_ps_Metal metal
{
	source RoRTaaResolve_ps.metal
	shader_reflection_pair_hint Ogre/Compositor/Quad_vs
}

fragment_program RoR/HDR/TaaResolve_ps unified
{
	delegate RoR/HDR/TaaResolve_ps_GLSL
	delegate RoR/HDR/TaaResolve_ps_VK
	delegate RoR/HDR/TaaResolve_ps_HLSL
	delegate RoR/HDR/TaaResolve_ps_Metal
}

material RoR/HDR/TaaResolve
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref RoR/HDR/TaaResolve_ps
			{
			}

			texture_unit rt0
			{
				tex_address_mode	clamp
				filtering			none
			}

			texture_unit depthTexture
			{
				tex_address_mode	clamp
				filtering			none
			}

			texture_unit motionTexture
			{
				tex_address_mode	clamp
				filtering			none
			}

			texture_unit prevDepthTexture
			{
				tex_address_mode	clamp
				filtering			none
			}

			// The only bilinear unit: history is sampled at a reprojected,
			// non-texel-aligned position.
			texture_unit historyTexture
			{
				tex_address_mode	clamp
				filtering			bilinear
			}

			texture_unit reactiveTexture
			{
				tex_address_mode	clamp
				filtering			none
			}
		}
	}
}

//------------------------
// Depth history store
//------------------------
fragment_program RoR/HDR/TaaDepthStore_ps_GLSL glsl
{
	source RoRTaaDepthStore_ps.glsl
	default_params
	{
		param_named depthTexture	int 0
	}
}

fragment_program RoR/HDR/TaaDepthStore_ps_VK glslvk
{
	source RoRTaaDepthStore_ps.glsl
}

fragment_program RoR/HDR/TaaDepthStore_ps_HLSL hlsl
{
	source RoRTaaDepthStore_ps.hlsl
	entry_point main
	target ps_5_0 ps_4_0
}

fragment_program RoR/HDR/TaaDepthStore_ps_Metal metal
{
	source RoRTaaDepthStore_ps.metal
	shader_reflection_pair_hint Ogre/Compositor/Quad_vs
}

fragment_program RoR/HDR/TaaDepthStore_ps unified
{
	delegate RoR/HDR/TaaDepthStore_ps_GLSL
	delegate RoR/HDR/TaaDepthStore_ps_VK
	delegate RoR/HDR/TaaDepthStore_ps_HLSL
	delegate RoR/HDR/TaaDepthStore_ps_Metal
}

material RoR/HDR/TaaDepthStore
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off
			cull_hardware none

			vertex_program_ref Ogre/Compositor/Quad_vs
			{
			}

			fragment_program_ref RoR/HDR/TaaDepthStore_ps
			{
			}

			texture_unit depthTexture
			{
				tex_address_mode	clamp
				filtering			none
			}
		}
	}
}
