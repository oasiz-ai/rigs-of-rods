#pragma once

// Absolute build-tree media root used only by the explicit no-suffix headless
// probe. Production bridge mode resolves immutable media relative to the
// running child executable and never consumes this build-tree path.
#define ROR_OGRE_NEXT_CHILD_SHADER_MEDIA_ROOT \
  "@ROR_OGRE_NEXT_CHILD_SHADER_MEDIA_ROOT@"
#define ROR_OGRE_NEXT_CHILD_SCOPE "probe-only-non-admitted"
#define ROR_OGRE_NEXT_CHILD_ROR_COMMIT "@ROR_SOURCE_COMMIT@"
#define ROR_OGRE_NEXT_CHILD_OGRE_COMMIT "@ROR_OGRE_NEXT_COMMIT@"
