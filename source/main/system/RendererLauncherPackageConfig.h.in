/// @file
/// @brief Generated, immutable public-launcher package facts.

#pragma once

#include "RendererStartupHandoff.h"

namespace RoR {
namespace RendererLauncherPackageConfig {

constexpr std::uint32_t kContractVersion =
    kRendererStartupHandoffContractVersion;
constexpr HostRenderPlatform kPackagePlatform =
    HostRenderPlatform::@ROR_RENDERER_LAUNCHER_PACKAGE_PLATFORM@;
constexpr bool kOgre14ChildPresent =
    @ROR_RENDERER_LAUNCHER_OGRE14_CHILD_PRESENT@;
constexpr bool kOgreNextChildPresent =
    @ROR_RENDERER_LAUNCHER_OGRE_NEXT_CHILD_PRESENT@;
constexpr bool kOgreNextChildProductionReady =
    @ROR_RENDERER_LAUNCHER_OGRE_NEXT_PRODUCTION_READY@;
constexpr bool kOgreNextPssmAdmitted =
    @ROR_RENDERER_LAUNCHER_OGRE_NEXT_PSSM_ADMITTED@;
constexpr NativeRayTracingBackend kNativeDirectionalShadowBackend =
    NativeRayTracingBackend::@ROR_RENDERER_LAUNCHER_NATIVE_SHADOW_BACKEND@;

// The argv encoder exists, but this bounded package still has no admitted
// production Ogre-Next game child. Keep its immutable facts categorically
// incapable of selecting a probe or incomplete presentation executable.
static_assert(kOgre14ChildPresent,
              "the phase-2 launcher requires the OGRE 14 game child");
static_assert(!kOgreNextChildPresent &&
                  !kOgreNextChildProductionReady &&
                  !kOgreNextPssmAdmitted &&
                  kNativeDirectionalShadowBackend ==
                      NativeRayTracingBackend::NONE,
              "Ogre-Next package admission requires a production-ready game child");

} // namespace RendererLauncherPackageConfig
} // namespace RoR
