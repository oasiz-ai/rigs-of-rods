{
  "schema": "ror.ogre_next_combined_executable.v1",
  "target": "RoR-Combined",
  "combined_runtime_definition": "ROR_OGRE_NEXT_COMBINED_RUNTIME=1",
  "provider_target": "RoR::OgreNextEmbeddedRuntime",
  "resource_stage_target": "ror_ogre_next_combined_resources",
  "shader_media_root": "@ROR_OGRE_NEXT_COMBINED_SHADER_MEDIA_ROOT@",
  "presentation_media_root": "@ROR_OGRE_NEXT_COMBINED_PRESENTATION_MEDIA_ROOT@",
  "runtime_media_layout": "resources/ogrenext",
  "build_root_runtime_dependency": false,
  "install_tree_rules_present": true,
  "provider_source_root": "@CMAKE_SOURCE_DIR@",
  "provider_source_manifest": "@ROR_SOURCE_MANIFEST@",
  "provider_source_manifest_file_count": @ROR_SOURCE_MANIFEST_FILE_COUNT@,
  "provider_source_manifest_sha256": "@ROR_SOURCE_MANIFEST_SHA256@",
  "provider_contract": "@ROR_OGRE_NEXT_COMBINED_PROVIDER_CONTRACT@",
  "namespace_audit_report": "@ROR_OGRE_NEXT_COMBINED_NAMESPACE_AUDIT_REPORT@",
  "provider_owned_source_count": @ROR_OGRE_NEXT_COMBINED_EXECUTABLE_PROVIDER_SOURCE_COUNT@,
  "provider_owned_sources": [@ROR_OGRE_NEXT_COMBINED_EXECUTABLE_PROVIDER_SOURCE_JSON@],
  "retired_renderer_source_count": @ROR_OGRE_NEXT_COMBINED_EXECUTABLE_RETIRED_SOURCE_COUNT@,
  "retired_renderer_sources": [@ROR_OGRE_NEXT_COMBINED_EXECUTABLE_RETIRED_SOURCE_JSON@],
  "remaining_game_source_count": @ROR_OGRE_NEXT_COMBINED_EXECUTABLE_REMAINING_SOURCE_COUNT@,
  "selected_game_source_root": "@CMAKE_CURRENT_LIST_DIR@",
  "selected_game_source_manifest": "@ROR_OGRE_NEXT_COMBINED_EXECUTABLE_SELECTED_SOURCE_MANIFEST@",
  "selected_game_source_manifest_sha256": "@ROR_OGRE_NEXT_COMBINED_EXECUTABLE_SELECTED_SOURCE_MANIFEST_SHA256@",
  "transport_or_bridge_sources_linked": false,
  "post_link_nm_gate": "tools/verify_ogre_next_combined_binary_closure.py",
  "raw_build_tree_demo": false,
  "app_bundle_staged": false
}
