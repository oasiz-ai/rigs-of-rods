#
# Conan recipe revisions hash exported source bytes. Force every local recipe
# input to LF so Windows and POSIX checkouts export the same locked revisions.
cmake/conan/recipes/** text eol=lf
cmake/conan/locks/*.lock text eol=lf
cmake/conan/recipes/ogre3d/patches/14.5.2/relocatable-install-paths.patch -whitespace
