--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -273,6 +273,18 @@
-  set(XCODE_ATTRIBUTE_SDKROOT macosx)
-  if(CMAKE_GENERATOR STREQUAL "Unix Makefiles")
-    execute_process(COMMAND xcodebuild -version -sdk "${XCODE_ATTRIBUTE_SDKROOT}" Path | head -n 1 OUTPUT_VARIABLE CMAKE_OSX_SYSROOT)
-    string(REGEX REPLACE "(\r?\n)+$" "" CMAKE_OSX_SYSROOT "${CMAKE_OSX_SYSROOT}")
-  else()
-    set(CMAKE_OSX_SYSROOT macosx)
+  # Preserve an absolute toolchain-provided SDK. CMake's Ninja generator
+  # forwards a literal SDK name directly to Clang, where `-isysroot macosx`
+  # is not a usable path.
+  set(_OGRE_MACOS_SDK "${CMAKE_OSX_SYSROOT}")
+  if(NOT _OGRE_MACOS_SDK OR NOT IS_ABSOLUTE "${_OGRE_MACOS_SDK}")
+    if(NOT _OGRE_MACOS_SDK)
+      set(_OGRE_MACOS_SDK macosx)
+    endif()
+    execute_process(
+      COMMAND xcrun --sdk "${_OGRE_MACOS_SDK}" --show-sdk-path
+      RESULT_VARIABLE _OGRE_MACOS_SDK_RESULT
+      OUTPUT_VARIABLE _OGRE_MACOS_SDK
+      ERROR_VARIABLE _OGRE_MACOS_SDK_ERROR
+      OUTPUT_STRIP_TRAILING_WHITESPACE)
+    if(NOT _OGRE_MACOS_SDK_RESULT EQUAL 0)
+      message(FATAL_ERROR
+        "Could not resolve the macOS SDK: ${_OGRE_MACOS_SDK_ERROR}")
+    endif()
@@ -279,0 +292,9 @@
+  if(NOT IS_DIRECTORY "${_OGRE_MACOS_SDK}")
+    message(FATAL_ERROR "Resolved macOS SDK is not a directory: ${_OGRE_MACOS_SDK}")
+  endif()
+  set(CMAKE_OSX_SYSROOT "${_OGRE_MACOS_SDK}" CACHE PATH
+    "macOS SDK used by Ogre" FORCE)
+  set(XCODE_ATTRIBUTE_SDKROOT "${_OGRE_MACOS_SDK}")
+  unset(_OGRE_MACOS_SDK)
+  unset(_OGRE_MACOS_SDK_RESULT)
+  unset(_OGRE_MACOS_SDK_ERROR)
