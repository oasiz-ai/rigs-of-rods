+        // past the mapped buffer instead of failing. Legacy v1.40 content does
+        // exactly that, and because the overrun usually lands in mapped memory
+        // it corrupts the heap silently and only occasionally faults.
+        //
+        // The passes write, per submesh, three indices for every triangle
+        // whose vertices changed plus three for every triangle that was not
+        // removed, and two per line on the same terms. Compare that total with
+        // the allocation before writing anything, so a mesh the generator
+        // cannot represent is refused while the buffers are still untouched.
+        {
+            std::vector<size_t> plannedIndices(submeshCount, 0);
+            bool accountingValid = true;
+            for (size_t i = 0; i < mTriangleCacheList.size() && accountingValid; i++) {
+                const size_t submesh = data->mTriangleList[i].submeshID;
+                if (submesh >= submeshCount) {
+                    accountingValid = false;
+                    break;
+                }
+                if (mTriangleCacheList[i].vertexChanged) {
+                    plannedIndices[submesh] += 3;
+                }
+                if (!data->mTriangleList[i].isRemoved) {
+                    plannedIndices[submesh] += 3;
+                }
+            }
+            for (size_t i = 0; i < mLineCacheList.size() && accountingValid; i++) {
