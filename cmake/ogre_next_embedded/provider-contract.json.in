{
  "schema": "ror.ogre_next_combined_provider.v1",
  "platform_policy": "@ROR_OGRE_NEXT_PLATFORM_POLICY@",
  "build_type": "@CMAKE_BUILD_TYPE@",
  "architecture": "@CMAKE_OSX_ARCHITECTURES@",
  "ror_commit": "@ROR_SOURCE_COMMIT@",
  "ror_source_root": "@CMAKE_SOURCE_DIR@",
  "ror_source_manifest": "@ROR_SOURCE_MANIFEST@",
  "ror_source_manifest_file_count": @ROR_SOURCE_MANIFEST_FILE_COUNT@,
  "ror_source_manifest_sha256": "@ROR_SOURCE_MANIFEST_SHA256@",
  "ogre_next_commit": "@ROR_OGRE_NEXT_COMMIT@",
  "ogre_next_archive_sha256": "@ROR_OGRE_NEXT_ARCHIVE_SHA256@",
  "ogre_next_upstream_strict_fp": true,
  "ogre_next_upstream_strict_fp_target_count": @ROR_OGRE_NEXT_UPSTREAM_STRICT_FP_TARGET_COUNT@,
  "authenticated_source_image_decoder": {
    "schema": "@ROR_STB_IMAGE_SOURCE_SCHEMA@",
    "upstream_commit": "@ROR_STB_IMAGE_UPSTREAM_COMMIT@",
    "macro_contract_verified": @ROR_STB_IMAGE_MACRO_CONTRACT_VERIFIED_JSON@,
    "source_lock": {
      "relative_path": "@ROR_STB_IMAGE_SOURCE_LOCK_RELATIVE_PATH@",
      "path": "@ROR_STB_IMAGE_SOURCE_LOCK_PATH@",
      "sha256": "@ROR_STB_IMAGE_SOURCE_LOCK_SHA256@"
    },
    "header": {
      "relative_path": "@ROR_STB_IMAGE_HEADER_RELATIVE_PATH@",
      "path": "@ROR_STB_IMAGE_HEADER_PATH@",
      "size": @ROR_STB_IMAGE_HEADER_SIZE@,
      "sha256": "@ROR_STB_IMAGE_HEADER_SHA256@"
    },
    "license": {
      "relative_path": "@ROR_STB_IMAGE_LICENSE_RELATIVE_PATH@",
      "path": "@ROR_STB_IMAGE_LICENSE_PATH@",
      "size": @ROR_STB_IMAGE_LICENSE_SIZE@,
      "sha256": "@ROR_STB_IMAGE_LICENSE_SHA256@"
    }
  },
  "rapidjson_archive_sha256": "@ROR_RAPIDJSON_ARCHIVE_SHA256@",
  "rapidjson_private_include_dir": "@ROR_OGRE_NEXT_RAPIDJSON_INCLUDE_DIR@",
  "rapidjson_document_header": "@ROR_OGRE_NEXT_RAPIDJSON_DOCUMENT_HEADER@",
  "rapidjson_document_header_size": @ROR_OGRE_NEXT_RAPIDJSON_DOCUMENT_HEADER_SIZE@,
  "rapidjson_document_header_sha256": "@ROR_OGRE_NEXT_RAPIDJSON_DOCUMENT_HEADER_SHA256@",
  "rapidjson_private_consumers": ["OgreNextMain", "OgreNextHlmsPbs", "OgreNextHlmsUnlit"],
  "rapidjson_interface_exported": false,
  "namespace": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_NAME@",
  "sdl_target": "@ROR_OGRE_NEXT_PRESENTATION_SDL_TARGET@",
  "sdl_conan_reference": "@ROR_ROOT_SDL_CONAN_REFERENCE@",
  "sdl_conan_lock": "@ROR_ROOT_CONAN_LOCK@",
  "sdl_conan_lock_sha256": "@ROR_ROOT_CONAN_LOCK_SHA256@",
  "sdl_imported_artifact_target": "@ROR_ROOT_SDL_IMPORTED_ARTIFACT_TARGET@",
  "sdl_imported_artifact": "@ROR_ROOT_SDL_IMPORTED_ARTIFACT@",
  "sdl_imported_artifact_size": @ROR_ROOT_SDL_IMPORTED_ARTIFACT_SIZE@,
  "sdl_imported_artifact_sha256": "@ROR_ROOT_SDL_IMPORTED_ARTIFACT_SHA256@",
  "sdl_conaninfo_sha256": "@ROR_ROOT_SDL_CONANINFO_SHA256@",
  "sdl_conanmanifest_sha256": "@ROR_ROOT_SDL_CONANMANIFEST_SHA256@",
  "sdl_package_identity_sha256": "@ROR_ROOT_SDL_PACKAGE_IDENTITY_SHA256@",
  "ogre14_runtime_library_count": @ROR_ROOT_OGRE14_RUNTIME_LIBRARY_COUNT@,
  "ogre14_runtime_manifest_sha256": "@ROR_ROOT_OGRE14_RUNTIME_MANIFEST_SHA256@",
  "ogre14_main_runtime": "@ROR_ROOT_OGRE14_MAIN_RUNTIME@",
  "ogre14_sdl_provider_runtime": "@ROR_ROOT_OGRE14_SDL_PROVIDER_RUNTIME@",
  "shader_media_root": "@ROR_OGRE_NEXT_COMBINED_SHADER_MEDIA_ROOT@",
  "shader_media_manifest_sha256": "@ROR_OGRE_NEXT_N1_MEDIA_MANIFEST_SHA256@",
  "hdr_media_manifest_sha256": "@ROR_OGRE_NEXT_N1_HDR_MEDIA_MANIFEST_SHA256@",
  "reflection_media_manifest_sha256": "@ROR_OGRE_NEXT_REFLECTION_MEDIA_MANIFEST_SHA256@",
  "presentation_media_root": "@ROR_OGRE_NEXT_COMBINED_PRESENTATION_MEDIA_ROOT@",
  "presentation_media_manifest_sha256": "@ROR_OGRE_NEXT_N1_PRESENTATION_MEDIA_MANIFEST_SHA256@",
  "transport_sources_linked": false,
  "bridge_sources_linked": false,
  "raw_build_tree_demo": true,
  "app_bundle_staged": false
}
