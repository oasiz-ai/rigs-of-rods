      "source_sha256": "@ROR_OGRE_NEXT_IBL_PATCH_SOURCE_SHA256@",
      "patched_sha256": "@ROR_OGRE_NEXT_IBL_PATCHED_SHA256@"
    },
    {
      "path": "@ROR_OGRE_NEXT_METAL_ANISOTROPY_PATCH_PATH@",
      "sha256": "@ROR_OGRE_NEXT_METAL_ANISOTROPY_PATCH_SHA256@",
      "reason": "@ROR_OGRE_NEXT_METAL_ANISOTROPY_PATCH_REASON@",
      "source_path": "@ROR_OGRE_NEXT_METAL_ANISOTROPY_SOURCE_PATH@",
      "source_sha256": "@ROR_OGRE_NEXT_METAL_ANISOTROPY_SOURCE_SHA256@",
      "patched_sha256": "@ROR_OGRE_NEXT_METAL_ANISOTROPY_PATCHED_SHA256@"
    },
    {
      "path": "@ROR_OGRE_NEXT_VULKAN_SKY_PATCH_PATH@",
