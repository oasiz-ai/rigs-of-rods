      "reason": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_PATCH_REASON@",
      "applied": true
    },
    "remap_header": {
      "path": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_REMAP_PATH@",
      "sha256": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_REMAP_SHA256@",
      "forced_include": true
    },
    "full_n1_link_evidence": "not_evaluated"
  }
}
