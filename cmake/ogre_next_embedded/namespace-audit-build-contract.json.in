      "reason": "@ROR_OGRE_NEXT_VULKAN_SKY_PATCH_REASON@",
      "source_path": "@ROR_OGRE_NEXT_VULKAN_SKY_SOURCE_PATH@",
      "source_sha256": "@ROR_OGRE_NEXT_VULKAN_SKY_SOURCE_SHA256@",
      "patched_sha256": "@ROR_OGRE_NEXT_VULKAN_SKY_PATCHED_SHA256@"
    }
  ],
  "embedded_namespace": {
    "enabled": true,
    "namespace": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_NAME@",
    "cmake_option": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_CMAKE_OPTION@",
    "default_enabled": false,
    "patch": {
      "path": "@ROR_OGRE_NEXT_EMBEDDED_NAMESPACE_PATCH_PATH@",
