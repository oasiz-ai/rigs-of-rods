  },
  "patches": [
    {
      "path": "@ROR_OGRE_NEXT_PATCH_PATH@",
      "sha256": "@ROR_OGRE_NEXT_PATCH_SHA256@",
      "reason": "@ROR_OGRE_NEXT_PATCH_REASON@"
    },
    {
      "path": "@ROR_OGRE_NEXT_IBL_PATCH_PATH@",
      "sha256": "@ROR_OGRE_NEXT_IBL_PATCH_SHA256@",
      "reason": "@ROR_OGRE_NEXT_IBL_PATCH_REASON@",
