vertex_program Ogre/Compositor/StdQuad_GLSL_vp glsl
{
	syntax glsl330
	source StdQuad_vp_gl3plus.glsl
	preprocessor_defines STDQUAD_BASE=1

	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
	}
}

vertex_program Ogre/Compositor/StdQuad_HLSL_vp hlsl
{
	source StdQuad_vp_d3d11.hlsl
	entry_point StdQuad_vp
	target vs_4_0

	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
	}
}

