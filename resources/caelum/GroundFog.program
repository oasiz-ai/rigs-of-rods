vertex_program CaelumGroundFogVP/GL3Plus glsl
{
    syntax glsl330
    source CaelumGroundFog_gl3plus.glsl
    preprocessor_defines CAELUM_GROUND_FOG_VERTEX=1
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto world world_matrix
    }
}

vertex_program CaelumGroundFogVP/D3D11 hlsl
{
    source CaelumGroundFog_d3d11.hlsl
    entry_point CaelumGroundFogVS
    target vs_4_0
    preprocessor_defines CAELUM_GROUND_FOG_VERTEX=1
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto world world_matrix
    }
}

vertex_program CaelumGroundFogVP unified
{
    delegate CaelumGroundFogVP/GL3Plus
    delegate CaelumGroundFogVP/D3D11
}

fragment_program CaelumGroundFogFP/GL3Plus glsl
{
    syntax glsl330
    source CaelumGroundFog_gl3plus.glsl
    preprocessor_defines CAELUM_GROUND_FOG_FRAGMENT=1
    default_params
    {
        param_named_auto camPos camera_position
        param_named fogDensity float 0
        param_named fogVerticalDecay float 0
        param_named fogGroundLevel float 0
        param_named fogColour float4 0 0 0 0
    }
}

fragment_program CaelumGroundFogFP/D3D11 hlsl
{
    source CaelumGroundFog_d3d11.hlsl
    entry_point CaelumGroundFogPS
    target ps_4_0
    preprocessor_defines CAELUM_GROUND_FOG_FRAGMENT=1
    default_params
    {
        param_named_auto camPos camera_position
        param_named fogDensity float 0
        param_named fogVerticalDecay float 0
        param_named fogGroundLevel float 0
        param_named fogColour float4 0 0 0 0
    }
}

fragment_program CaelumGroundFogFP unified
{
    delegate CaelumGroundFogFP/GL3Plus
    delegate CaelumGroundFogFP/D3D11
}

