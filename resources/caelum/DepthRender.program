vertex_program Caelum/DepthRenderVP/GL3Plus glsl
{
    syntax glsl330
    source DepthComposer_gl3plus.glsl
    preprocessor_defines CAELUM_DEPTH_RENDER_VERTEX=1
    default_params
    {
        param_named_auto wvpMatrix worldviewproj_matrix
    }
}

vertex_program Caelum/DepthRenderVP/D3D11 hlsl
{
    source DepthComposer_d3d11.hlsl
    entry_point CaelumDepthRenderVS
    target vs_4_0
    preprocessor_defines CAELUM_DEPTH_RENDER_VERTEX=1
    default_params
    {
        param_named_auto wvpMatrix worldviewproj_matrix
    }
}

vertex_program Caelum/DepthRenderVP unified
{
    delegate Caelum/DepthRenderVP/GL3Plus
    delegate Caelum/DepthRenderVP/D3D11
}

fragment_program Caelum/DepthRenderFP/GL3Plus glsl
{
    syntax glsl330
    source DepthComposer_gl3plus.glsl
    preprocessor_defines CAELUM_DEPTH_RENDER_FRAGMENT=1
}

fragment_program Caelum/DepthRenderFP/D3D11 hlsl
{
    source DepthComposer_d3d11.hlsl
    entry_point CaelumDepthRenderPS
    target ps_4_0
    preprocessor_defines CAELUM_DEPTH_RENDER_FRAGMENT=1
}

fragment_program Caelum/DepthRenderFP unified
{
    delegate Caelum/DepthRenderFP/GL3Plus
    delegate Caelum/DepthRenderFP/D3D11
}

vertex_program Caelum/DepthRenderAlphaRejectionVP/GL3Plus glsl
{
    syntax glsl330
    source DepthComposer_gl3plus.glsl
    preprocessor_defines CAELUM_DEPTH_ALPHA_VERTEX=1
    default_params
    {
        param_named_auto wvpMatrix worldviewproj_matrix
    }
}

vertex_program Caelum/DepthRenderAlphaRejectionVP/D3D11 hlsl
{
    source DepthComposer_d3d11.hlsl
    entry_point CaelumDepthAlphaVS
    target vs_4_0
    preprocessor_defines CAELUM_DEPTH_ALPHA_VERTEX=1
    default_params
    {
        param_named_auto wvpMatrix worldviewproj_matrix
    }
}

vertex_program Caelum/DepthRenderAlphaRejectionVP unified
{
    delegate Caelum/DepthRenderAlphaRejectionVP/GL3Plus
    delegate Caelum/DepthRenderAlphaRejectionVP/D3D11
}

fragment_program Caelum/DepthRenderAlphaRejectionFP/GL3Plus glsl
{
    syntax glsl330
    source DepthComposer_gl3plus.glsl
    preprocessor_defines CAELUM_DEPTH_ALPHA_FRAGMENT=1
    default_params
    {
        param_named mainTex int 0
    }
}

fragment_program Caelum/DepthRenderAlphaRejectionFP/D3D11 hlsl
{
    source DepthComposer_d3d11.hlsl
    entry_point CaelumDepthAlphaPS
    target ps_4_0
    preprocessor_defines CAELUM_DEPTH_ALPHA_FRAGMENT=1
}

fragment_program Caelum/DepthRenderAlphaRejectionFP unified
{
    delegate Caelum/DepthRenderAlphaRejectionFP/GL3Plus
    delegate Caelum/DepthRenderAlphaRejectionFP/D3D11
}
