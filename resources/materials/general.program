// Modern GL3Plus/D3D11 closure for the historical general shader family.

vertex_program ambient_vs/GL3Plus glsl
{
    syntax glsl330
    source general_gl3plus.glsl
    preprocessor_defines GENERAL_VERTEX_AMBIENT=1
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
    }
}

vertex_program ambient_vs/D3D11 hlsl
{
    source general_d3d11.hlsl
    entry_point GeneralAmbientVS
    target vs_4_0
    preprocessor_defines GENERAL_VERTEX_AMBIENT=1
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
    }
}

fragment_program ambient_ps/GL3Plus glsl
{
    syntax glsl330
    source general_gl3plus.glsl
    preprocessor_defines GENERAL_FRAGMENT_AMBIENT=1
    default_params
    {
        param_named_auto ambient ambient_light_colour
        param_named_auto matDif surface_diffuse_colour
        param_named diffuseMap int 0
    }
}

fragment_program ambient_ps/D3D11 hlsl
{
    source general_d3d11.hlsl
    entry_point GeneralAmbientPS
    target ps_4_0
    preprocessor_defines GENERAL_FRAGMENT_AMBIENT=1
    default_params
    {
        param_named_auto ambient ambient_light_colour
        param_named_auto matDif surface_diffuse_colour
    }
}

