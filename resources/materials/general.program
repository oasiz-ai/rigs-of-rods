vertex_program ambient_vs unified
{
    delegate ambient_vs/GL3Plus
    delegate ambient_vs/D3D11
}

fragment_program ambient_ps unified
{
    delegate ambient_ps/GL3Plus
    delegate ambient_ps/D3D11
}

