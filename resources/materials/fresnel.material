//----------------------------
// Distortion effects
//----------------------------

vertex_program Examples/FresnelRefractReflectVP/GL3Plus glsl
{
	syntax glsl330
	source Example_Fresnel_gl3plus.glsl
	preprocessor_defines FRESNEL_WATER_VERTEX=1
}

vertex_program Examples/FresnelRefractReflectVP/D3D11 hlsl
{
	source Example_Fresnel_d3d11.hlsl
	entry_point FresnelWaterVS
	target vs_4_0
	preprocessor_defines FRESNEL_WATER_VERTEX=1
}

vertex_program Examples/FresnelRefractReflectVP unified
{
	delegate Examples/FresnelRefractReflectVP/GL3Plus
	delegate Examples/FresnelRefractReflectVP/D3D11
}

fragment_program Examples/FresnelRefractReflectFP/GL3Plus glsl
{
	syntax glsl330
	source Example_Fresnel_gl3plus.glsl
	preprocessor_defines FRESNEL_WATER_FRAGMENT_FULL=1
	default_params
	{
		param_named noiseMap int 0
		param_named reflectMap int 1
		param_named refractMap int 2
	}
}

fragment_program Examples/FresnelRefractReflectFP/D3D11 hlsl
{
	source Example_Fresnel_d3d11.hlsl
	entry_point FresnelWaterFullPS
	target ps_4_0
	preprocessor_defines FRESNEL_WATER_FRAGMENT_FULL=1
}

fragment_program Examples/FresnelRefractReflectFP unified
{
	delegate Examples/FresnelRefractReflectFP/GL3Plus
	delegate Examples/FresnelRefractReflectFP/D3D11
}

// Preserve the historical compatibility alias while routing it to the same
// modern full reflection/refraction programs.
fragment_program Examples/FresnelRefractReflectPS unified
{
	delegate Examples/FresnelRefractReflectFP/GL3Plus
	delegate Examples/FresnelRefractReflectFP/D3D11
}

material Examples/FresnelReflectionRefraction
{
	receive_shadows off 
	// Modern full reflection/refraction path
	technique
	{
		pass 
		{
		   cull_hardware none
//			scene_blend alpha_blend
			
			vertex_program_ref Examples/FresnelRefractReflectVP
			{
				param_named_auto worldViewProjMatrix worldviewproj_matrix
				param_named_auto eyePosition camera_position_object_space
				param_named fresnelBias float -0.3 
				param_named fresnelScale float 1.4 
				param_named fresnelPower float 8.0  
				param_named_auto timeVal time 0.05
				param_named scroll float 1.0  
				param_named scale float 4.0 
				param_named noise float 1.0 
				// scroll and noisePos will need updating per frame
			}
			fragment_program_ref Examples/FresnelRefractReflectFP
			{
				param_named distortionRange float 0.025 
				param_named tintColour float4 0.05 0.12 0.15 1.0
			}
			// Noise
			texture_unit
			{
				// Perlin noise volume
				texture perlinvolume.dds 3d
				// min / mag filtering, no mip
				filtering linear linear none
			}
			// Reflection
			texture_unit
			{
				// Will be filled in at runtime
				texture Reflection 2d 0 PF_R8G8B8
				tex_address_mode clamp
				// Projective reflection coordinates
				tex_coord_set 1
			}
			// Refraction
			texture_unit
			{
				// Will be filled in at runtime
				texture Refraction 2d 0 PF_R8G8B8
				tex_address_mode clamp
				// Projective refraction coordinates
				tex_coord_set 2
			}
		}
		
			
	}

}

